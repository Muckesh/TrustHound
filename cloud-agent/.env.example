LLM_PROVIDER=ollama        # ollama | groq
LLM_MODEL=qwen2.5:7b       # any model name valid for the chosen provider

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Leave OLLAMA_API_KEY empty for local — it defaults to "ollama" automatically.

# --- Ollama Cloud ---
# Change OLLAMA_BASE_URL to the cloud endpoint and set your API key:
# OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_API_KEY=

# --- Groq (free cloud, switch LLM_PROVIDER=groq) ---
GROQ_API_KEY=gsk_...

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=hackathon
